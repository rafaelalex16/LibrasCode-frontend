# Copie para .env e preencha com os dados do projeto Supabase (Project Settings > API)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable

# Login, turmas e histórico no banco: false (padrão) deixa os portais abertos sem cadastro
VITE_LOGIN_ATIVO=false

# Opcional: endereço do servidor da aula ao vivo (padrão: ws://<mesmo computador>:8003/librasCodeWebsocket)
# VITE_WS_URL=wss://aula.suaescola.com.br/librasCodeWebsocket
